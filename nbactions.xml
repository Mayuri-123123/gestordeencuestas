<?xml version="1.0" encoding="UTF-8"?>
<!-- ==========================================================================
     ¿PARA QUÉ SIRVE ESTE ARCHIVO?
     --------------------------------------------------------------------------
     Le dice a NetBeans qué hacer con los botones "Run Project (F6)" y "Debug".
     Con esta configuración, F6 compila y abre directamente la ventana moderna
     (EncuestaGUI). Sin este archivo, NetBeans igual abre el proyecto Maven,
     pero el F6 podría no saber qué clase arrancar.
     ========================================================================== -->
<actions>
  <action>
    <actionName>run</actionName>
    <displayName>Ejecutar ventana (EncuestaGUI)</displayName>
    <goals>
      <goal>process-classes</goal>
      <goal>org.codehaus.mojo:exec-maven-plugin:3.1.0:exec</goal>
    </goals>
    <properties>
      <exec.args>-Dfile.encoding=UTF-8 -classpath %classpath com.mycompany.gestordeencuestas.EncuestaGUI</exec.args>
      <exec.executable>java</exec.executable>
    </properties>
  </action>
  <action>
    <actionName>debug</actionName>
    <displayName>Depurar ventana (EncuestaGUI)</displayName>
    <goals>
      <goal>process-classes</goal>
      <goal>org.codehaus.mojo:exec-maven-plugin:3.1.0:exec</goal>
    </goals>
    <properties>
      <exec.args>-Dfile.encoding=UTF-8 -Xdebug -Xrunjdwp:transport=dt_socket,server=n,address=${jpda.address} -classpath %classpath com.mycompany.gestordeencuestas.EncuestaGUI</exec.args>
      <exec.executable>java</exec.executable>
      <jpda.listen>true</jpda.listen>
    </properties>
  </action>
</actions>
